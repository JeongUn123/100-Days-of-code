from robolink import *
from robodk import *

# 1. connect and first setup
RDK = Robolink()

# robot_A
robotA = RDK.Item('UR10')             
gripperA = RDK.Item('OnRobot Gecko SP1 Single Pad Gripper')

# robot_B
robotB = RDK.Item('UR5')             
gripperB = RDK.Item('OnRobot Gecko SP3 Single Pad Gripper')     

box = RDK.Item('Box')


# Move_Pose_set(UR10)
move1 = RDK.Item('Move1')
move2 = RDK.Item('Move2')
safety_pose = RDK.Item('Safety_pose')
exchange_UR10 = RDK.Item('UR10_Exchange')
pick_target = RDK.Item('Picking') 

# Move_Pose_set(UR5)
UR5_move1 = RDK.Item('UR5_Move1')
UR5_move2 = RDK.Item('UR5_Move2')
exchange_UR5 = RDK.Item('UR5_Exchange') 
place_target = RDK.Item('Placing')


# Validation Check
if not robotA.Valid() or not robotB.Valid():
    print("Check the robot name! The name is same as in RoboDK station.")
    quit()

# 2. Initial Positioning
print("Position Resetting...")
robotA.MoveJ(robotA.JointsHome())
robotB.MoveJ(robotB.JointsHome())

box.setParentStatic(RDK.ActiveStation())
box.setPose(pick_target.Pose())            


# 3. Work Start: Handover between Robot A and Robot B
print("Robot A: Picking the Box.")
robotA.MoveJ(move1)        
robotA.MoveJ(pick_target)
box.setParentStatic(gripperA)     
box.setPose(transl(0,0,0))     
print("Robot A: Get box!")


# Move to exchange point
robotA.MoveJ(exchange_UR10)

robotB.MoveJ(exchange_UR5) 

# Hand over
print("Handover: A -> B")
box.setParentStatic(gripperB)     
box.setPose(transl(0,0,0))  
robotA.MoveJ(safety_pose)      

robotA.MoveL(robotA.Pose() * transl(-200, 0, 0)) 
print("Robot A: success.")
robotA.MoveJ(robotA.JointsHome())

print("Robot B: Move to Target")
robotB.MoveJ(UR5_move1)
robotB.MoveJ(UR5_move2)
robotB.MoveJ(place_target)

box.setParentStatic(RDK.Item('New Station'))
print("Work finish!")
robotB.MoveJ(robotB.JointsHome())
